<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shuttlewcs.db.WcsStationMapper">

    <resultMap id="rs" type="com.example.shuttlewcs.db.WcsStation">
        <id     property="stationId"       column="station_id"/>
        <result property="stationType"     column="station_type"/>
        <result property="status"          column="status"/>
        <result property="curEqpPalletId"  column="cur_eqp_pallet_id"/>
        <result property="statusChangedAt" column="status_changed_at"/>
        <result property="createdAt"       column="created_at"/>
        <result property="updatedAt"       column="updated_at"/>
        <result property="createdBy"       column="created_by"/>
        <result property="updatedBy"       column="updated_by"/>
    </resultMap>

    <select id="findById" resultMap="rs">
        SELECT * FROM biz.wcs_station
        WHERE station_id = #{stationId}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM biz.wcs_station
    </select>

    <!-- STATION_STATUS 수신 upsert — 최초 보고 시 자동 생성 -->
    <insert id="upsertStatus">
        INSERT INTO biz.wcs_station (
            station_id, station_type, status, status_changed_at
        ) VALUES (
            #{stationId},
            COALESCE(#{stationType}, 'INBOUND'),
            #{status}, #{changedAt}
        )
        ON CONFLICT (station_id) DO UPDATE SET
            station_type      = COALESCE(EXCLUDED.station_type, biz.wcs_station.station_type),
            status            = EXCLUDED.status,
            status_changed_at = EXCLUDED.status_changed_at,
            updated_at        = CURRENT_TIMESTAMP
    </insert>

    <update id="updateStatusAndPallet">
        UPDATE biz.wcs_station
        SET status            = #{status},
            cur_eqp_pallet_id = #{curEqpPalletId},
            status_changed_at = #{changedAt},
            updated_at        = CURRENT_TIMESTAMP
        WHERE station_id = #{stationId}
    </update>

</mapper>
