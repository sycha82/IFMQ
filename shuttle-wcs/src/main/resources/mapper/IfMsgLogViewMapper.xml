<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shuttlewcs.db.IfMsgLogViewMapper">

    <resultMap id="rs" type="com.example.shuttlewcs.db.IfMsgLogView">
        <id     property="logId"        column="log_id"/>
        <result property="direction"    column="direction"/>
        <result property="messageType"  column="message_type"/>
        <result property="messageId"    column="message_id"/>
        <result property="refMessageId" column="ref_message_id"/>
        <result property="routingKey"   column="routing_key"/>
        <result property="queueName"    column="queue_name"/>
        <result property="payload"      column="payload"/>
        <result property="status"       column="status"/>
        <result property="errorMsg"     column="error_msg"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <!-- payload 는 jsonb — ::text 로 캐스팅해 문자열로 받는다 -->
    <select id="findRecent" resultMap="rs">
        SELECT log_id, direction, message_type, message_id, ref_message_id,
               routing_key, queue_name, payload::text AS payload,
               status, error_msg, created_at
          FROM inf.if_msg_log
        ORDER BY log_id DESC
        LIMIT #{limit}
    </select>

</mapper>
