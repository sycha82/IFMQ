<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shuttlewcs.db.WcsInventoryMapper">

    <resultMap id="rs" type="com.example.shuttlewcs.db.WcsInventory">
        <id     property="sku"         column="sku"/>
        <id     property="locationId"  column="location_id"/>
        <result property="quantity"    column="quantity"/>
        <result property="reservedQty" column="reserved_qty"/>
        <result property="uom"         column="uom"/>
        <result property="updatedAt"   column="updated_at"/>
    </resultMap>

    <select id="findByPk" resultMap="rs">
        SELECT * FROM biz.wcs_inventory
        WHERE sku = #{sku} AND location_id = #{locationId}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM biz.wcs_inventory
    </select>

    <!-- INBOUND_DONE 재고 누적 — 최초면 insert, 있으면 수량 가산 -->
    <insert id="upsertAdd">
        INSERT INTO biz.wcs_inventory (sku, location_id, quantity, uom)
        VALUES (#{sku}, #{locationId}, #{qty}, COALESCE(#{uom}, 'EA'))
        ON CONFLICT (sku, location_id) DO UPDATE SET
            quantity   = biz.wcs_inventory.quantity + EXCLUDED.quantity,
            updated_at = CURRENT_TIMESTAMP
    </insert>

    <!-- OUTBOUND_CMD 할당 시 팔렛 전체 예약 — 미예약(reserved_qty=0)인 라인만 reserved_qty=quantity 로 -->
    <update id="reserveByLocation">
        UPDATE biz.wcs_inventory
        SET reserved_qty = quantity,
            updated_at   = CURRENT_TIMESTAMP
        WHERE location_id  = #{locationId}
          AND reserved_qty = 0
    </update>

    <!-- 예약 여부 조회 — 해당 위치에 예약된 라인 존재 여부 -->
    <select id="existsReservedByLocation" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM biz.wcs_inventory
            WHERE location_id = #{locationId}
              AND reserved_qty > 0
        )
    </select>

    <!-- OUTBOUND_DONE 랙 재고 제거 — 팔렛 배출로 해당 위치(eqp_pallet_id) 재고 전체 삭제 -->
    <delete id="deleteByLocation">
        DELETE FROM biz.wcs_inventory
        WHERE location_id = #{locationId}
    </delete>


    <!-- 모니터링 조회 — 가용재고 뷰 -->
    <resultMap id="rsAvail" type="com.example.shuttlewcs.db.WcsAvailableInventory">
        <result property="sku"          column="sku"/>
        <result property="locationId"   column="location_id"/>
        <result property="quantity"     column="quantity"/>
        <result property="reservedQty"  column="reserved_qty"/>
        <result property="availableQty" column="available_qty"/>
        <result property="uom"          column="uom"/>
        <result property="updatedAt"    column="updated_at"/>
    </resultMap>

    <select id="findAllAvailable" resultMap="rsAvail">
        SELECT sku, location_id, quantity, reserved_qty, available_qty, uom, updated_at
          FROM biz.wcs_vw_available_inventory
        ORDER BY sku, location_id
    </select>

</mapper>
