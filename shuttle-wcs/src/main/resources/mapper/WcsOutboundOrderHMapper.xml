<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shuttlewcs.db.WcsOutboundOrderHMapper">

    <resultMap id="rs" type="com.example.shuttlewcs.db.WcsOutboundOrderH">
        <id     property="taskId"          column="task_id"/>
        <result property="cmdStatus"       column="cmd_status"/>
        <result property="recvMessageId"   column="recv_message_id"/>
        <result property="lastMessageId"   column="last_message_id"/>
        <result property="recvCount"       column="recv_count"/>
        <result property="receivedAt"      column="received_at"/>
        <result property="completedAt"     column="completed_at"/>
        <result property="createdAt"       column="created_at"/>
        <result property="updatedAt"       column="updated_at"/>
        <result property="createdBy"       column="created_by"/>
        <result property="updatedBy"       column="updated_by"/>
    </resultMap>

    <select id="findByTaskId" resultMap="rs">
        SELECT * FROM biz.wcs_outbound_order_h
        WHERE task_id = #{taskId}
    </select>

    <select id="findByStatus" resultMap="rs">
        SELECT * FROM biz.wcs_outbound_order_h
        WHERE cmd_status = #{cmdStatus}
        ORDER BY received_at
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM biz.wcs_outbound_order_h
    </select>

    <insert id="insert" parameterType="com.example.shuttlewcs.db.WcsOutboundOrderH">
        INSERT INTO biz.wcs_outbound_order_h (
            task_id, cmd_status,
            recv_message_id, last_message_id, recv_count,
            received_at,
            created_by, updated_by
        ) VALUES (
            #{taskId}, COALESCE(#{cmdStatus}, 'RECEIVED'),
            #{recvMessageId}, #{lastMessageId}, COALESCE(#{recvCount}, 1),
            COALESCE(#{receivedAt}, now()),
            COALESCE(#{createdBy}, 'SYSTEM'), COALESCE(#{updatedBy}, 'SYSTEM')
        )
    </insert>

    <update id="updateStatus">
        UPDATE biz.wcs_outbound_order_h
        SET cmd_status = #{cmdStatus},
            completed_at = CASE WHEN #{cmdStatus} = 'COMPLETED' THEN now() ELSE completed_at END,
            updated_at = now()
        WHERE task_id = #{taskId}
    </update>

</mapper>
